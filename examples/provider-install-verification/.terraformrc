# Local development override for testing the provider without publishing it.
#
# 1. Build and install the provider:   go install .
# 2. Point Terraform at this file:      export TF_CLI_CONFIG_FILE=$(pwd)/.terraformrc
# 3. Run terraform commands as usual (no `terraform init` required with overrides).
#
# Replace the path below with your GOBIN (run `go env GOBIN`, or fall back to
# `$(go env GOPATH)/bin`).
provider_installation {
  dev_overrides {
    "eshiam-corp/eshiam" = "REPLACE_WITH_GOBIN_PATH"
  }

  # For all other providers, install them directly from their origin registries.
  direct {}
}
